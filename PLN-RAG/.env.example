#  LLM — choose one provider

# Option A: Gemini (recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-2.0-flash

# Option B: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=openai/gpt-4o-mini

#  LangExtract Parser (only parser supported)
# LANGEXTRACT_API_KEY falls back to GEMINI_API_KEY when unset.
LANGEXTRACT_API_KEY=
LANGEXTRACT_MODEL_ID=gemini-2.5-flash
LANGEXTRACT_MODEL_URL=
LANGEXTRACT_EXAMPLES_PATH=data/langextract_examples.json
LANGEXTRACT_EXTRACTION_PASSES=1
LANGEXTRACT_MAX_WORKERS=1
LANGEXTRACT_CACHE_ENABLED=true
LANGEXTRACT_CACHE_MAX_ENTRIES=128
LANGEXTRACT_SKIP_FUZZY=true
# Optional; defaults to CHUNK_SIZE when unset.
LANGEXTRACT_CHUNK_SIZE=2000
MENTION_PREPASS_ENABLED=true

# Optional document-level neural coreference. Disabled by default.
# Install requirements-coref.txt before enabling LingMess.
# For Docker builds, set PLNRAG_INSTALL_COREF=true before docker compose --build.
PLNRAG_INSTALL_COREF=false
PLNRAG_LIGHT_INSTALL_COREF=false
COREFERENCE_ENABLED=false
COREFERENCE_BACKEND=lingmess
COREFERENCE_MODEL=biu-nlp/lingmess-coref
COREFERENCE_DEVICE=auto
COREFERENCE_MODE=hint_only
COREFERENCE_FAIL_OPEN=true
COREFERENCE_MAX_TOKENS_IN_BATCH=10000
COREFERENCE_INCLUDE_PAIR_LOGITS=false

#  Vector store 
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pln_rag_evidence_v2
QDRANT_HYBRID_ENABLED=true
OLLAMA_URL=http://localhost:11434/api/embeddings
OLLAMA_MODEL=nomic-embed-text

# Authoritative evidence ledger. Qdrant and Atomspace can be rebuilt from it.
EVIDENCE_LEDGER_ENABLED=true
EVIDENCE_LEDGER_PATH=data/evidence/evidence.db
EVIDENCE_OUTBOX_BATCH_SIZE=256

#  Atomspace 
ATOMSPACE_PATH=data/atomspace/kb.metta

# Predicate registry / mapping graph
PREDICATE_REGISTRY_ENABLED=true
PREDICATE_REGISTRY_PATH=data/predicate_registry.json
PREDICATE_MAPPING_ENABLED=true
PREDICATE_MAPPING_LLM_ENABLED=true
# Online mapping is advisory and disabled on the synchronous proof path.
PREDICATE_MAPPING_ONLINE_ENABLED=false
# Semantic mappings never create proof atoms unless explicitly opted in.
PREDICATE_MAPPING_EMIT_BRIDGES=false
PREDICATE_MAPPING_COLLECTION=pln_rag_predicates
PREDICATE_MAPPING_TOP_K=6
PREDICATE_MAPPING_MAX_CANDIDATES=6
PREDICATE_MAPPING_MIN_SCORE=0.62
PREDICATE_MAPPING_PROOF_THRESHOLD=0.82
PREDICATE_MAPPING_TIMEOUT=12
PREDICATE_MAPPING_TOTAL_TIMEOUT=30

#  FAISS (no longer used)
FAISS_PATH=data/faiss

#  Processing 
CHUNK_SIZE=2000
CHUNK_OVERLAP=64
CONTEXT_TOP_K=10

#  Reasoning 
CHAINING_TIMEOUT=30
CHAINING_MAX_STEPS=100
STRICT_PROOF_VALIDATION_ENABLED=true

#  Query execution 
QUERY_FALLBACK_ENABLED=true
QUERY_ALIGNMENT_ENABLED=true
QUERY_ALIGNMENT_TOP_K=8
QUERY_ALIGNMENT_MIN_SCORE=0.55
QUERY_ALIGNMENT_HYBRID_MIN_SCORE=0.30
